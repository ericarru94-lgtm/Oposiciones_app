DATABASE_URL="postgresql://oposiciones:oposiciones@localhost:5432/oposiciones_e2e?schema=public"
PORT=3002

# Suficientemente alto para no interferir con el onboarding (mini-test +
# primer test ~11 preguntas), pero bajo para poder agotarlo rápido en el
# test E2E del límite diario (drenado vía API antes de tocar la UI).
FREE_PLAN_DAILY_LIMIT=20

ADMIN_EMAILS="admin-e2e@example.com"

# Sin CLERK_SECRET_KEY/CLERK_PUBLISHABLE_KEY a propósito: Playwright no puede
# completar un login real de Clerk (requiere red hacia clerk.com). En su
# lugar, este secreto habilita el bypass de test de middleware/auth.ts —
# NUNCA definir esta variable fuera de .env.e2e. Ver backend/docs/clerk.md.
AUTH_TEST_BYPASS_SECRET="e2e-solo-para-tests"
