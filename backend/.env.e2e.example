DATABASE_URL="postgresql://oposiciones:oposiciones@localhost:5432/oposiciones_e2e?schema=public"
PORT=3002

# Suficientemente alto para no interferir con el onboarding (mini-test +
# primer test ~11 preguntas), pero bajo para poder agotarlo rápido en el
# test E2E del límite diario (drenado vía API antes de tocar la UI).
FREE_PLAN_DAILY_LIMIT=20

ADMIN_EMAILS="admin-e2e@example.com"

# Vacías A PROPÓSITO (no simplemente ausentes): @prisma/client carga su
# propio .env por defecto al inicializarse (ver backend/docs/testing.md),
# así que si se omiten aquí, Prisma las rellena solas con los valores
# reales de backend/.env — filtrando esas claves a este entorno aislado.
# Dejarlas como string vacío ya cuenta como "definida" para ese mecanismo
# (y para dotenv-cli), así que bloquea el relleno. Playwright no puede
# completar un login real de Clerk (requiere red hacia clerk.com) ni un
# pago real de Stripe (red hacia api.stripe.com); en su lugar, el secreto
# de abajo habilita el bypass de test de middleware/auth.ts —
# NUNCA definir esa variable fuera de .env.e2e. Ver backend/docs/clerk.md.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Mismo motivo que las de arriba: vacías a propósito para bloquear la fuga
# de las VAPID reales de backend/.env — sin esto, el scheduler de
# recordatorios diarios (server.ts) se programaría también en el proceso
# de E2E, algo que no debe depender de las claves reales de desarrollo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AUTH_TEST_BYPASS_SECRET="e2e-solo-para-tests"
