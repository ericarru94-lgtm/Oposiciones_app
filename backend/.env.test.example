DATABASE_URL="postgresql://oposiciones:oposiciones@localhost:5432/oposiciones_test?schema=public"
FREE_PLAN_DAILY_TEST_SESSIONS=2
ADMIN_EMAILS="admin-test@example.com"
# Valores de relleno: los tests mockean el cliente de Stripe (lib/stripe.ts),
# nunca llaman a la API real. Solo hace falta que existan.
STRIPE_PRICE_ID="price_test_dummy"
STRIPE_WEBHOOK_SECRET="whsec_test_dummy"
# Vacías a propósito (no ausentes): @prisma/client carga su propio .env por
# defecto al inicializarse y, si se omiten, rellenaría estas dos con los
# valores reales de backend/.env — ver el mismo comentario, más detallado,
# en .env.e2e.example. Cada test mockea "lib/stripe.ts" de todas formas.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Valores de relleno: cada test mockea "@clerk/express" por completo (ver
# test-utils/clerkMock.ts), nunca se llama al SDK real. Solo hacen falta
# para que app.ts monte clerkMiddleware() (mockeado) en vez del paso-a-través.
CLERK_SECRET_KEY="sk_test_dummy"
CLERK_PUBLISHABLE_KEY="pk_test_dummy"
