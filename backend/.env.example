DATABASE_URL="postgresql://oposiciones:oposiciones@localhost:5432/oposiciones?schema=public"
PORT=3001

# Límite diario de tests empezados (Practicar tema / Repasar hoy) para el plan gratuito
FREE_PLAN_DAILY_TEST_SESSIONS=2

# Emails con acceso a la herramienta de revisión editorial (/admin/*).
# Se activa solo al registrarse/iniciar sesión con uno de estos emails.
ADMIN_EMAILS="tu-email@example.com"

# Clerk (autenticación) — claves de tu instancia de Clerk (dashboard.clerk.com).
# Sin ellas el backend arranca igual, pero ninguna ruta protegida autentica.
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Stripe (usa las claves de tu cuenta en modo test/sandbox, nunca las de producción aquí).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Se rellena tras ejecutar `npm run stripe:setup-producto` (o crearlo a mano en el Dashboard).
STRIPE_PRICE_ID="price_..."
# Se rellena al correr `stripe listen --forward-to localhost:3001/api/stripe/webhook`
# (o al crear el endpoint de webhook en el Dashboard de Stripe).
STRIPE_WEBHOOK_SECRET="whsec_..."

# Origen del frontend, para las URLs de éxito/cancelación del Checkout,
# y para los enlaces de confirmación/baja de los emails de la newsletter.
FRONTEND_URL=http://localhost:5173

# Resend (envío de los emails de la newsletter: confirmación y bienvenida).
# Sin ella, /newsletter/suscribir sigue guardando el consentimiento con
# normalidad — solo falla (y lo deja en el log) el envío del email. Ver
# backend/docs/newsletter.md para darte de alta en Resend.
RESEND_API_KEY="re_..."
# Remitente de esos emails. Mientras Aprobox no tenga un dominio propio
# verificado en Resend, tiene que ser este dominio de pruebas — Resend
# solo entrega con él al email de la propia cuenta de Resend.
RESEND_FROM_EMAIL="Aprobox <onboarding@resend.dev>"

# Notificaciones push (recordatorio diario de repaso). Genera un par con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Sin ellas, /api/push/* responde "no configurado" y el frontend no
# muestra el aviso para activarlas — ver backend/docs/notificaciones-push.md.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:aprobox.app@gmail.com"
