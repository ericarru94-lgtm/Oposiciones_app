{
  "name": "oposiciones-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de la app de preparación de oposiciones (Auxiliar Administrativo del Estado)",
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && (node dist/scripts/import-questions.js || true) && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "import:questions": "tsx src/scripts/import-questions.ts",
    "stripe:setup-producto": "tsx src/scripts/setup-stripe-product.ts",
    "enviar-recordatorios": "dotenv -e .env -- tsx src/scripts/enviar-recordatorios-diarios.ts",
    "pretest": "dotenv -e .env.test -- prisma migrate deploy",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "e2e:reset": "dotenv -e .env.e2e -- prisma migrate deploy && dotenv -e .env.e2e -- tsx src/scripts/seed-e2e.ts",
    "e2e:serve": "dotenv -e .env.e2e -- tsx src/server.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^4.6.0",
    "prisma": "^5.20.0",
    "resend": "^6.25.0",
    "stripe": "^22.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
