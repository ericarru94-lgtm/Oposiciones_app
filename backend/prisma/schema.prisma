// Prisma schema for the Oposiciones prep app (Auxiliar Administrativo del Estado)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Catálogo de contenidos
// --------------------------------------------------------------------------

enum Bloque {
  I
  II
}

enum TipoPregunta {
  teorica
  psicotecnica
}

enum OrigenPregunta {
  examen_oficial
  generada_ia
}

enum EstadoPregunta {
  borrador
  verificada
  anulada
}

enum Opcion {
  a
  b
  c
  d
}

model Tema {
  id        Int          @id @default(autoincrement())
  bloque    Bloque
  numero    Int
  nombre    String
  /// Resumen/esquema de estudio breve del tema (no un temario completo),
  /// redactado a partir de texto legal público (dominio público en España)
  /// más redacción propia — nunca copiado de academias o webs privadas con
  /// copyright. Ver backend/docs/contenido-estudio.md.
  resumen           String?
  resumenGeneradoIA Boolean  @default(false)
  preguntas Pregunta[]

  @@unique([bloque, numero])
}

/// Pregunta del banco de preguntas. El campo `id` reutiliza el identificador
/// del dataset de origen (p.ej. "q0001") para poder re-importar sin duplicar.
model Pregunta {
  id                     String         @id
  tema                   Tema?          @relation(fields: [temaId], references: [id])
  temaId                 Int?
  enunciado              String
  opciones               Json // array de 4 strings, orden = a,b,c,d
  respuestaCorrecta      Opcion?
  explicacion            String?
  /// true si `explicacion` la redactó una IA (a partir de la fuente ya
  /// vinculada, o de forma conceptual si no había fuente) en vez de venir
  /// del examen oficial o de una revisión editorial humana. El frontend usa
  /// esto para mostrar un aviso discreto junto a la explicación.
  explicacionGeneradaIA  Boolean        @default(false)
  fuente                 String?
  origen                 OrigenPregunta
  convocatoria           String?
  estado                 EstadoPregunta @default(borrador)
  fechaVerificacion      DateTime?
  reportesUsuario        Int            @default(0)
  tipo                   TipoPregunta
  esPreguntaReserva      Boolean        @default(false)
  numeroOriginalExamen   Int?

  progresos Progreso[]
  intentos  Intento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo, estado])
  @@index([temaId])
}

// --------------------------------------------------------------------------
// Usuarios y progreso
// --------------------------------------------------------------------------

enum Plan {
  free
  premium
}

model Usuario {
  id            String   @id @default(cuid())
  email         String   @unique
  /// Nullable: la autenticación ahora la gestiona Clerk (ver clerkUserId).
  /// Solo quedaría poblado en filas creadas antes de la migración a Clerk.
  passwordHash  String?
  /// Id del usuario en Clerk (p.ej. "user_xxx"). Se rellena en el primer
  /// login vía obtenerOCrearUsuarioDesdeClerk (lib/clerkSync.ts), que crea
  /// la fila si es la primera vez que ese usuario de Clerk inicia sesión.
  clerkUserId   String?  @unique
  nivelInicial  String? // resultado del onboarding (p.ej. "principiante", "intermedio", "avanzado")

  /// `plan` y `premiumHasta` son el gate que usa el resto de la app (p.ej.
  /// lib/dailyLimit.ts) — nunca se escriben a mano, los mantiene al día el
  /// webhook de Stripe (routes/stripe.ts) a partir de los eventos de la
  /// suscripción. `premiumHasta` refleja el `current_period_end` de Stripe.
  plan          Plan      @default(free)
  premiumHasta  DateTime? // fin del periodo de suscripción activa, null si nunca ha pagado

  /// Identidad de facturación en Stripe — se crea el Customer en el primer
  /// intento de checkout, de ahí en adelante siempre se reutiliza el mismo.
  stripeCustomerId       String? @unique
  /// Id de la Subscription de Stripe más reciente del usuario (como mucho
  /// una activa a la vez: un único plan premium mensual).
  stripeSubscriptionId   String? @unique
  /// Estado tal cual lo manda Stripe (active, trialing, past_due, canceled,
  /// unpaid, incomplete, incomplete_expired...) — se guarda el string crudo
  /// en vez de un enum propio para no necesitar una migración cada vez que
  /// Stripe lo amplíe; solo "active"/"trialing" habilitan `plan = premium`.
  stripeSubscriptionStatus String?
  /// Reflejo de `subscription.cancel_at_period_end`: true cuando el usuario
  /// ya canceló desde el Billing Portal pero Stripe mantiene el acceso
  /// premium hasta el fin del periodo ya pagado (comportamiento normal de
  /// Stripe, no un impago). Sirve para que Perfil pueda avisar de la
  /// cancelación programada en vez de parecer que no ha pasado nada.
  cancelaAlFinalizarPeriodo Boolean @default(false)

  /// Acceso a la herramienta de revisión editorial. Se activa sola (no hay
  /// alta manual en BD) para cualquier email listado en ADMIN_EMAILS al
  /// iniciar sesión o registrarse — ver lib/adminEmails.ts.
  esAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())

  progresos Progreso[]
  intentos  Intento[]
}

/// Estado de repetición espaciada (SM-2) por usuario y pregunta.
model Progreso {
  id              String    @id @default(cuid())
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId       String
  pregunta        Pregunta  @relation(fields: [preguntaId], references: [id])
  preguntaId      String

  // Parámetros SM-2
  repeticiones    Int       @default(0)
  factorFacilidad Float     @default(2.5)
  intervaloDias   Int       @default(0)
  proximaRevision DateTime  @default(now())
  ultimaRevision  DateTime?
  ultimaCalidad   Int? // calidad 0-5 de la última respuesta (algoritmo SM-2)

  vecesVista      Int       @default(0)
  vecesCorrecta   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, preguntaId])
  @@index([usuarioId, proximaRevision])
}

/// Registro de cada respuesta dada, tanto de usuarios registrados como
/// anónimos (mini-test sin registro). Sirve para el panel de progreso y
/// para aplicar el límite diario del plan gratuito.
model Intento {
  id             String    @id @default(cuid())
  usuario        Usuario?  @relation(fields: [usuarioId], references: [id])
  usuarioId      String?
  /// Identificador de sesión anónima (cookie/localStorage) cuando no hay usuario.
  sesionAnonima  String?
  pregunta       Pregunta  @relation(fields: [preguntaId], references: [id])
  preguntaId     String
  opcionElegida  Opcion?
  esCorrecta     Boolean
  tiempoMs       Int?
  createdAt      DateTime  @default(now())

  @@index([usuarioId, createdAt])
  @@index([sesionAnonima, createdAt])
}

// --------------------------------------------------------------------------
// Newsletter (RGPD: doble opt-in)
// --------------------------------------------------------------------------

enum EstadoSuscripcionNewsletter {
  /// Ya dio el consentimiento y se generó el token de confirmación, pero
  /// todavía no ha confirmado por email (el envío de la confirmación no
  /// está implementado todavía — ver backend/docs/newsletter.md).
  pendiente
  confirmado
  baja
}

/// Alta a la newsletter (RGPD: consentimiento explícito + doble opt-in).
/// No implementa el envío del email de confirmación todavía (ver
/// backend/docs/newsletter.md) — solo la captura del consentimiento, con
/// fecha, y el token que activará la confirmación cuando se conecte un
/// proveedor de email.
model NewsletterSuscriptor {
  id                  String                      @id @default(cuid())
  email               String                      @unique
  consentimiento      Boolean
  fechaConsentimiento DateTime
  estado              EstadoSuscripcionNewsletter  @default(pendiente)
  tokenConfirmacion   String                       @unique
  tokenBaja           String                       @unique
  confirmadoEn        DateTime?
  bajaEn              DateTime?
  createdAt           DateTime                     @default(now())
}
