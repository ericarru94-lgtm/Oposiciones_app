VITE_API_URL=http://localhost:3002/api
# Sin VITE_CLERK_PUBLISHABLE_KEY a propósito: activa el modo de bypass de
# SessionContext, que Playwright controla inyectando un token en
# localStorage (ver e2e/helpers.ts). Debe coincidir con
# backend/.env.e2e#AUTH_TEST_BYPASS_SECRET.
VITE_E2E_AUTH_BYPASS_SECRET="e2e-solo-para-tests"
