VITE_API_URL=http://localhost:3002/api
# Vacía A PROPÓSITO (no simplemente ausente): Vite carga en cascada
# .env, .env.local, .env.[modo] y .env.[modo].local, y las claves NO
# redefinidas en un archivo más específico se rellenan solas con las del
# .env base — así que si se omitiera aquí, esta seguiría siendo la clave
# real de frontend/.env. Definirla vacía sí la sobreescribe y activa el
# modo de bypass de SessionContext, que Playwright controla inyectando un
# token en localStorage (ver e2e/helpers.ts). VITE_E2E_AUTH_BYPASS_SECRET
# debe coincidir con backend/.env.e2e#AUTH_TEST_BYPASS_SECRET.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_E2E_AUTH_BYPASS_SECRET="e2e-solo-para-tests"
