VITE_API_URL=http://localhost:3001/api
# Clave publicable de tu instancia de Clerk (dashboard.clerk.com). Sin ella
# la app arranca (no rompe el resto del desarrollo) pero cae en el modo de
# bypass pensado solo para Playwright (ver context/SessionContext.tsx):
# no hay ninguna forma de iniciar sesión de verdad desde la UI. Necesaria
# para probar cualquier flujo autenticado en local.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Google Analytics 4 (measurement de conversiones para medir campañas de
# Google Ads/Meta Ads). Sin esta variable, lib/analytics.ts es un no-op:
# no se muestra el banner de cookies ni se carga ningún script de Google.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Etiqueta de conversión de Google Ads (Herramientas > Configuración de
# conversiones). Opcional: sin ella solo se manda la config de GA4.
VITE_GOOGLE_ADS_ID="AW-XXXXXXXXXX"

# "send_to" de la acción de conversión "Sign-up" (Goals > Conversions >
# [acción] > "See event snippet" en Google Ads). Opcional: sin ella,
# registrarConversionRegistro() no hace nada.
VITE_GOOGLE_ADS_SIGNUP_SEND_TO="AW-XXXXXXXXXX/XXXXXXXXXXXXXXXXXXXX"
