# HE SIGNAL AI OFFICE · copia este archivo a .env.local y rellénalo.
# Nunca subas .env.local a GitHub.

# ── Supabase (obligatorio) · Project Settings → API Keys ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…). Solo servidor: ejecutor de agentes y scripts.
SUPABASE_SECRET_KEY=

# ── Administrador · única cuenta con acceso ──
ADMIN_EMAIL=

# ── Anthropic (fase 3) · https://platform.claude.com → API Keys ──
ANTHROPIC_API_KEY=
# claude-opus-5-5 (por defecto), claude-sonnet-5-5 o claude-haiku-5-5
DEFAULT_AGENT_MODEL=claude-opus-5-5
# Los límites de gasto se configuran en la propia oficina (Configuración)
# y se guardan en la base de datos: el motor los aplica antes de cada paso.

# ── n8n (fase 5) ──
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ── Solo desarrollo: ver la interfaz sin Supabase (nunca funciona en producción) ──
LOCAL_PREVIEW=
